# Rendered by playbooks/watcher/install.yml from watcher/dagu/check-dag.yaml.j2 — edit the template.
# Dagu does not reload a changed DAG behind a symlink, so a change here restarts Dagu (the playbook
# notifies its handler); without that, a new schedule is written and silently ignored.
description: >
  {{ item.description }}
  Exit 0 satisfied, 1 a finding, 2 the facts could not be established — the failed step's name says
  which, and that name is what reaches Telegram.
labels: [workspace={{ item.workspace }}]
schedule: "{{ item.schedule }}"

steps:
  # The 1Password API specifically: run.sh cannot resolve a single credential without it.
  - id: wait_for_network
    command: curl -sS -o /dev/null --max-time 10 https://my.1password.com
    retry_policy: {limit: 30, interval_sec: 60}

  # The pins the checks compare against, and AWX's task_replicas. A failed pull leaves yesterday's
  # clone in place — stale pins are still pins — so it never fails the run.
  #
  # flock, because the three checks share one clone: when Dagu catches up several missed runs at
  # once they start together, and concurrent pulls in one repo fail ("Cannot fast-forward to
  # multiple branches" — the first catch-up, 2026-09-27). -w 120 so a stuck pull cannot hold a check.
  - id: refresh_pins
    depends: [wait_for_network]
    command: flock -w 120 {{ watcher_home }}/.pins.lock git -C {{ watcher_home }}/helm-override-files pull --ff-only -q
    continue_on: {failure: true}

  # Always exits 0 so its full report stays readable; the verdict steps below carry the result. The
  # report is also kept in a file, for the notification gate and the alert message.
  # No retry: a retry only repeats a finding and spends 1Password quota (run.sh).
  - id: {{ item.step }}
    depends: [refresh_pins]
    timeout_sec: 1800
    command: sh -c './run.sh python3 -u checks/{{ item.script }} > "/tmp/dagu-out-${DAG_RUN_ID}" 2>&1; c=$?; cat "/tmp/dagu-out-${DAG_RUN_ID}"; echo $c > "/tmp/dagu-verdict-${DAG_RUN_ID}"'

  # Decides whether this result reaches Telegram: a new or changed finding does, the same one again does
  # not — except once a day as a reminder. See notify-gate.sh. Fails open (alerts) if it cannot decide.
  - id: notify_gate
    depends: [{{ item.step }}]
    command: sh -c './notify-gate.sh {{ item.name }} "$(cat /tmp/dagu-verdict-${DAG_RUN_ID})" "/tmp/dagu-out-${DAG_RUN_ID}" > "/tmp/dagu-gate-${DAG_RUN_ID}" || echo alert > "/tmp/dagu-gate-${DAG_RUN_ID}"; echo "notification -> $(cat /tmp/dagu-gate-${DAG_RUN_ID})"'

  # The verdict steps fail — which is what Dagu notifies on — only when the gate says "alert". Their
  # stderr carries the failing lines, which Dagu puts in the message as {{ '{{' }}run.error{{ '}}' }}.
  - id: finding
    depends: [notify_gate]
    preconditions:
      - condition: 'test "$(cat /tmp/dagu-verdict-${DAG_RUN_ID})" = 1'
      - condition: 'test "$(cat /tmp/dagu-gate-${DAG_RUN_ID})" = alert'
    command: sh -c 'grep -E "^\s+(FAIL|UNKNOWN)\s|^\s+! " "/tmp/dagu-out-${DAG_RUN_ID}" | sed -E "s/^\s+//; s/  +/ /g" | head -6 >&2; echo "FINDING — a success predicate is false. Read the {{ item.step }} step log."; exit 1'

  - id: facts_not_established
    depends: [notify_gate]
    preconditions:
      - condition: 'test "$(cat /tmp/dagu-verdict-${DAG_RUN_ID})" = 2'
      - condition: 'test "$(cat /tmp/dagu-gate-${DAG_RUN_ID})" = alert'
    command: sh -c 'grep -E "^\s+UNKNOWN\s|FACTS NOT ESTABLISHED" "/tmp/dagu-out-${DAG_RUN_ID}" | sed -E "s/^\s+//; s/  +/ /g" | head -6 >&2; echo "FACTS NOT ESTABLISHED — the check could not see (rule 8). Not evidence about the estate."; exit 1'

  - id: check_broken
    depends: [notify_gate]
    preconditions:
      - condition: 'test "$(cat /tmp/dagu-verdict-${DAG_RUN_ID})" -gt 2'
      - condition: 'test "$(cat /tmp/dagu-gate-${DAG_RUN_ID})" = alert'
    command: sh -c 'tail -5 "/tmp/dagu-out-${DAG_RUN_ID}" >&2; echo "CHECK BROKEN — the checker itself crashed or was not found."; exit 1'

  # The same finding again, inside the day: recorded here, not sent. Succeeds, so Dagu stays quiet.
  - id: known_finding
    depends: [notify_gate]
    preconditions:
      - condition: 'test "$(cat /tmp/dagu-verdict-${DAG_RUN_ID})" != 0'
      - condition: 'test "$(cat /tmp/dagu-gate-${DAG_RUN_ID})" = quiet'
    command: sh -c 'echo "Known finding, unchanged — not re-sent (a reminder goes out once a day). State file $HOME/watcher/state/{{ item.name }}.state"'

handler_on:
  exit:
    command: rm -f "/tmp/dagu-verdict-${DAG_RUN_ID}" "/tmp/dagu-out-${DAG_RUN_ID}" "/tmp/dagu-gate-${DAG_RUN_ID}"
