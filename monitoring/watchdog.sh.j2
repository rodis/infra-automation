#!/usr/bin/env bash
# Rendered by playbooks/monitoring/install.yml from monitoring/watchdog.sh.j2 — edit the template.
#
# Keep the monitoring stack running. Called by cron every 5 minutes and @reboot: a Managed VPS gives no
# root and no system service, and user systemd units stop at logout (Linger=no), so cron supervises —
# the same shape as the watcher's own watchdog, on the same box, as a different user.
#
# Starting only what is not already running makes it safe to call as often as cron likes. "[x]" in each
# pgrep pattern means the pattern can never match a command line that merely contains it.
set -u
H="{{ monitoring_home }}"
B="{{ monitoring_bin }}"
L="$H/logs"
mkdir -p "$L"

# Logs are appended (>>), so truncating one in place is safe while its process keeps writing. A log
# is history, not state; 50 MB is far more than any question asked of it needs.
for f in "$L"/*.log; do
  [ -f "$f" ] && [ "$(stat -c %s "$f")" -gt 52428800 ] && : > "$f"
done

note() { echo "$(date -u +%FT%TZ) watchdog: $*" >>"$L/watchdog.log"; }

# VictoriaMetrics single-node. Loopback only, AND password-protected: loopback alone is not a boundary
# on a shared box — every local user (the watcher, the agent's rods_reader) could otherwise write to it
# without a token, which would break "the agent never holds a way to write what it is graded on". The
# password comes from a 600 file into the ENVIRONMENT (-envflag.enable), never the command line, which
# `ps` shows to every user; a process's environment is readable only by its own user.
# GOMEMLIMIT is the Go runtime's soft ceiling; the box's 4 GiB cgroup cap is shared with the watcher and
# kills rather than swaps, so every process here gets a ceiling well below it.
if ! pgrep -u "$(id -u)" -f "$B/[v]ictoria-metrics-prod" >/dev/null; then
  httpAuth_username=vmauth httpAuth_password="$(cat "$H/config/vm-password")" \
  GOMEMLIMIT={{ monitoring_vm_gomemlimit }} nohup "$B/victoria-metrics-prod" \
    -envflag.enable \
    -storageDataPath="$H/data/victoria-metrics" \
    -retentionPeriod={{ monitoring_vm_retention }} \
    -httpListenAddr=127.0.0.1:{{ monitoring_vm_port }} \
    -memory.allowedBytes={{ monitoring_vm_cache_bytes }} \
    -search.maxConcurrentRequests={{ monitoring_vm_max_concurrent_queries }} \
    -search.maxMemoryPerQuery={{ monitoring_vm_max_memory_per_query }} \
    -selfScrapeInterval=30s \
    >>"$L/victoria-metrics.log" 2>&1 &
  note "started victoria-metrics (pid $!)"
fi

# VictoriaLogs (2026-10-09): loopback only, its own password, the same pattern as VictoriaMetrics.
# -retention.maxDiskSpaceUsageBytes is a safety cap so a log flood cannot fill the shared disk.
# -loki.disableMessageParsing keeps each pushed line whole in _msg, as Loki does. Without it a JSON line
# (etcd, cert-manager) is split into fields with no _msg at all, so a check that matches text in the
# line would match nothing (found on the first day, 2026-10-09).
if ! pgrep -u "$(id -u)" -f "$B/[v]ictoria-logs-prod" >/dev/null; then
  httpAuth_username=vmauth httpAuth_password="$(cat "$H/config/vl-password")" TZ="" \
  GOMEMLIMIT={{ monitoring_vl_gomemlimit }} nohup "$B/victoria-logs-prod" \
    -envflag.enable \
    -storageDataPath="$H/data/victoria-logs" \
    -retentionPeriod={{ monitoring_vl_retention }} \
    -retention.maxDiskSpaceUsageBytes={{ monitoring_vl_max_disk }} \
    -httpListenAddr=127.0.0.1:{{ monitoring_vl_port }} \
    -loki.disableMessageParsing \
    -memory.allowedBytes={{ monitoring_vl_cache_bytes }} \
    -search.maxConcurrentRequests={{ monitoring_vl_max_concurrent_queries }} \
    -search.maxQueryDuration={{ monitoring_vl_max_query_duration }} \
    >>"$L/victoria-logs.log" 2>&1 &
  note "started victoria-logs (pid $!)"
fi

# vmagent (2026-10-17): meta-monitoring. Scrapes this box's own components on loopback and ships a
# keep-listed handful of series OUT to Grafana Cloud, which is the only thing watching this box —
# the checks, the metrics store and the Telegram notifier all live here, so nothing on this machine
# can report that this machine died.
#
# Rendered only when a Grafana remote-write credential was supplied at launch; without one this
# block is absent and the stack is exactly what it was before.
#
# The bearer token is a FILE (-remoteWrite.basicAuth.passwordFile), not a flag value and not an
# environment variable: `ps` shows command lines to every user on this shared box, which is why
# VictoriaMetrics' own password takes the same route. The URL and the user (a numeric instance id)
# are not secrets.
#
# -remoteWrite.tmpDataPath buffers on disk when Grafana Cloud is unreachable, capped so a long
# outage cannot fill the disk VictoriaMetrics and the watcher share.
{% if monitoring_vmagent_enabled %}
if ! pgrep -u "$(id -u)" -f "$B/[v]magent-prod" >/dev/null; then
  GOMEMLIMIT={{ monitoring_vmagent_gomemlimit }} nohup "$B/vmagent-prod" \
    -promscrape.config="$H/config/vmagent.yml" \
    -remoteWrite.url={{ monitoring_grafana_remote_write_url }} \
    -remoteWrite.basicAuth.username={{ monitoring_grafana_remote_write_user }} \
    -remoteWrite.basicAuth.passwordFile="$H/config/grafana-remote-write-token" \
    -remoteWrite.urlRelabelConfig="$H/config/vmagent-relabel.yml" \
    -remoteWrite.tmpDataPath="$H/data/vmagent" \
    -remoteWrite.maxDiskUsagePerURL={{ monitoring_vmagent_max_disk }} \
    -httpListenAddr=127.0.0.1:{{ monitoring_vmagent_port }} \
    -memory.allowedBytes={{ monitoring_vmagent_cache_bytes }} \
    >>"$L/vmagent.log" 2>&1 &
  note "started vmagent (pid $!)"
fi
{% else %}
# No Grafana remote-write credential was supplied at install time, so there is no vmagent and
# NOTHING OUTSIDE THIS BOX IS WATCHING IT. That is a real gap, not a configuration preference.
{% endif %}

# vmauth: the ONLY process on this box that listens publicly. TLS, a bearer token per sender, each
# token routed only to the write path. Its own /metrics and /health are moved to loopback with
# -httpInternalListenAddr, so the public port serves nothing without a token.
if ! pgrep -u "$(id -u)" -f "$B/[v]mauth-prod" >/dev/null; then
  GOMEMLIMIT={{ monitoring_vmauth_gomemlimit }} nohup "$B/vmauth-prod" \
    -auth.config="$H/config/vmauth.yml" \
    -httpListenAddr=0.0.0.0:{{ monitoring_vmauth_port }} \
    -httpInternalListenAddr=127.0.0.1:{{ monitoring_vmauth_internal_port }} \
    -tls -tlsCertFile="$H/tls/vmauth.crt" -tlsKeyFile="$H/tls/vmauth.key" -tlsMinVersion=TLS13 \
    >>"$L/vmauth.log" 2>&1 &
  note "started vmauth (pid $!)"
fi
