// Managed by playbooks/observability/install_alloy.yml — edits here are overwritten.
//
// Host metrics only. PostgreSQL metrics are deliberately absent: they need a dedicated read-only
// pg_monitor role rather than the application's DB_USER, which is a database change of its own.

prometheus.exporter.unix "host" {
  // Trimmed on purpose. Grafana Cloud free allows 10,000 active series and the default collector
  // set runs 500-1000 per host, so the whole estate would sit near the cap before anything
  // interesting is added. These cover the questions actually being asked of this host: is it up,
  // is it stalling, is it out of disk or memory.
  set_collectors = [
    "cpu",
    "diskstats",
    "filesystem",
    "loadavg",
    "meminfo",
    "netdev",
    "stat",      // includes CPU steal — the counter that mattered when guests were locking up
    "time",      // clock drift, which Mimir cares about
    "uname",
  ]

  // Pseudo-filesystems produce a series per mount and answer nothing.
  filesystem {
    fs_types_exclude = "^(autofs|binfmt_misc|cgroup.?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|procfs|pstore|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|sys|run/credentials/.+|var/lib/docker/.+|var/lib/containers/storage/.+)($|/)"
  }
}

// The unix exporter's targets carry __address__ = 127.0.0.1:12345, so without this every series
// would be labelled instance="127.0.0.1:12345" and be useless the moment there is a second host.
// Set here rather than on remote_write: a global rule also renames series scraped from something
// REMOTE, which stamped AWX's metrics with the name of the machine that scraped them.
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "instance"
    replacement  = "{{ inventory_hostname }}"
  }
}

prometheus.scrape "host" {
  targets    = discovery.relabel.host.output
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  scrape_interval = "{{ alloy_scrape_interval }}"

  // Without this every series is labelled instance="127.0.0.1:12345", which is useless the moment
  // there is more than one host. The inventory name is what the objectives and the ledgers use.
  job_name = "integrations/node_exporter"
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_remote_write_url }}"

    basic_auth {
      username = "{{ alloy_remote_write_user }}"
      password = "{{ alloy_remote_write_token }}"
    }

    // Mimir rejects out-of-order samples outright rather than dropping them quietly, so a backlog
    // after an outage can wedge the queue. Keep the buffer modest and let old samples go: for
    // "is this host alive", recent truth beats complete history.
    queue_config {
      capacity          = 2500
      max_shards        = 4
      max_samples_per_send = 500
    }

  }
}

{% if alloy_ship_logs %}

// ---------------------------------------------------------------------------------------------
// LOGS
//
// Metrics say a host is unwell; logs say why. Every diagnosis on 2026-08-22 came from a log line
// and not from a threshold — soft lockups in dmesg, Alloy's own "permission denied", a Neutron
// port stuck DOWN — so this is the half that makes a retrospective possible.
//
// It also fixes a stated blind spot in AWX [67] Check kernel health: that reads dmesg live, the
// ring buffer wraps, and a reboot erases it entirely. Shipped to Loki, a soft lockup stays
// queryable for 14 days and survives the reboot that hid it.
// ---------------------------------------------------------------------------------------------

loki.relabel "journal" {
  // forward_to is empty on purpose: this component exists only to export .rules to the source
  // below. It is the documented way to attach relabelling to a journal source.
  forward_to = []

  // Keep the label set SMALL and bounded. Loki charges for stream cardinality, not volume, and
  // the free tier rejects writes rather than degrading. `unit` and `level` are bounded by the
  // machine; anything derived from message text or a PID is unbounded and would be a slow-motion
  // outage.
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  // Alloy is by far the noisiest unit on these hosts — roughly 870 lines per 15 minutes, about
  // 83k a day, almost all of it the collector narrating its own scrape loop. Dropping its info and
  // debug lines removes the bulk of the volume and loses nothing anyone would query.
  //
  // Its warn/error/crit lines are KEPT deliberately. Those are how we would learn that shipping
  // has broken, and a collector that stops reporting its own failures is the observability
  // equivalent of a smoke alarm with the battery out.
  rule {
    source_labels = ["__journal__systemd_unit", "__journal_priority_keyword"]
    separator     = ";"
    regex         = "alloy\\.service;(info|debug)"
    action        = "drop"
  }

  // Collapse transient per-login units into one stream. systemd names each SSH session
  // `session-<N>.scope` with an ever-increasing N, so left alone `unit` is an UNBOUNDED label and
  // every login creates a new Loki stream. Loki charges on stream cardinality and the free tier
  // rejects writes rather than degrading, so this is a slow-motion outage rather than a tidiness
  // issue. Already visible before this rule: session-5246, session-5248, and climbing.
  rule {
    source_labels = ["unit"]
    regex         = "session-\\d+\\.scope"
    target_label  = "unit"
    replacement   = "session.scope"
  }

  // Same shape: systemd-run and udev spawn transient units with generated names.
  rule {
    source_labels = ["unit"]
    regex         = "(run-r?[0-9a-f]+|systemd-[a-z]+-[0-9]+)\\.(scope|service|mount)"
    target_label  = "unit"
    replacement   = "transient"
  }
}

loki.source.journal "journal" {
  forward_to    = [loki.write.grafana_cloud.receiver]
  relabel_rules = loki.relabel.journal.rules
  max_age       = "{{ alloy_journal_max_age }}"

  labels = {
    job      = "journal",
    instance = "{{ inventory_hostname }}",
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_loki_url }}"

    basic_auth {
      username = "{{ alloy_loki_user }}"
      password = "{{ alloy_loki_token }}"
    }
  }
}
{% endif %}

{% if alloy_scrape_awx %}

// ---------------------------------------------------------------------------------------------
// AWX (level 3)
//
// AWX already publishes 70 Prometheus metrics of its own — capacity, remaining capacity, instance
// status, job launch counts, and awx_database_connections_total. Nothing needed installing for
// this; the endpoint was simply unread.
//
// Scraped from OUTSIDE the cluster AWX runs in, so that an AWX outage produces up{job="awx"} == 0
// rather than an absence of data. Absence is indistinguishable from a broken collector; a zero is
// a measurement.
// ---------------------------------------------------------------------------------------------

prometheus.scrape "awx" {
  targets = [{
    __address__      = "{{ alloy_awx_url | regex_replace('^https?://', '') | regex_replace('/$', '') }}",
    __scheme__       = "https",
    __metrics_path__ = "/api/v2/metrics",
  }]

  // No honor_labels, and no instance label on the target. AWX distinguishes its per-pod series with
  // `hostname` and `instance_uuid`, NOT with `instance` — checked, rather than inferred:
  //
  //   awx_instance_capacity{hostname="awx-task-…",instance_uuid="…",node_type="control"}
  //
  // honor_labels was added here on the assumption that a target `instance` label was colliding with
  // AWX's own and collapsing six series into one. That assumption came from num_dropped=18 matching
  // 6 pods x 3 capacity metrics, and it was wrong — there was never a collision, because the label
  // names differ. It is removed rather than left in as a harmless-looking extra: a setting kept for
  // a reason that turned out to be false is a trap for whoever reads it next.
  bearer_token    = "{{ alloy_awx_token }}"
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "awx"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}
{% endif %}

{% if alloy_has_etcd | default(false) %}

// ---------------------------------------------------------------------------------------------
// etcd (level 2) — only rendered on hosts where 127.0.0.1:2381 actually answered.
//
// etcd is the one Kubernetes component that exposes metrics without credentials, and it is also
// the one whose failure is hardest to diagnose after the fact: a slow or unhealthy etcd presents
// as the API server being slow, which presents as everything being slow.
// ---------------------------------------------------------------------------------------------

prometheus.scrape "etcd" {
  targets = [{
    __address__      = "127.0.0.1:2381",
    __scheme__       = "http",
    __metrics_path__ = "/metrics",
    instance         = "{{ inventory_hostname }}",
  }]
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "etcd"
  // Through the keep-list below, not straight to remote_write.
  forward_to      = [prometheus.relabel.etcd_keep.receiver]
}

// Alloy filters metrics with a prometheus.relabel COMPONENT in the forward chain. It has no
// `metric_relabel_config` block inside prometheus.scrape — that is Prometheus' own YAML config
// syntax, and putting it here made the config unparseable, so Alloy refused to start and master-1
// stopped shipping anything at all. The playbook's own assertion caught that; systemd reported the
// service as failed and the counters were zero.
//
// Why a keep-list at all: etcd cost 1478 active series from ONE node, of which
// grpc_server_handled_total alone was 731 through method x code x service cardinality. Three
// production control planes untrimmed would have been ~4400 and put the free tier's 10,000 out of
// reach. What survives is what the Kubernetes dashboard reads plus what the standard etcd alerts
// need. grpc_server_started_total is kept for request rate by method; handled_total is dropped,
// which costs the per-code error breakdown — the one real loss, and the dashboard says so.
prometheus.relabel "etcd_keep" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex  = "up|etcd_server_has_leader|etcd_server_leader_changes_seen_total|etcd_server_proposals_(committed|applied|failed)_total|etcd_server_proposals_pending|etcd_server_health_failures|etcd_mvcc_db_total_size_in_bytes|etcd_mvcc_db_total_size_in_use_in_bytes|etcd_debugging_mvcc_(keys|watcher)_total|etcd_disk_wal_fsync_duration_seconds_(bucket|count|sum)|etcd_disk_backend_commit_duration_seconds_(bucket|count|sum)|etcd_network_peer_round_trip_time_seconds_(bucket|count|sum)|etcd_network_client_grpc_(received|sent)_bytes_total|grpc_server_started_total|process_resident_memory_bytes|process_cpu_seconds_total"
    action = "keep"
  }
}
{% endif %}
{% if alloy_has_apiserver | default(false) %}

// The API server answered /healthz, but there is deliberately NO scrape for it.
//
// /healthz returns the string "ok", not Prometheus exposition format, so prometheus.scrape can
// never parse it and produces up{job="kube-apiserver"} = 0 forever — a permanent zero that reads
// exactly like a dead control plane. A metric that is always wrong is worse than a missing one.
//
// Liveness of an endpoint that does not speak Prometheus is a job for a blackbox probe
// (prometheus.exporter.blackbox), and the API server's real /metrics needs a bearer token, which
// means the in-cluster ServiceAccount from the infra-observability policy. Both are follow-ups.
{% endif %}
{% if alloy_has_postgres | default(false) %}

// ---------------------------------------------------------------------------------------------
// PostgreSQL — only rendered on a host that actually has a local socket.
//
// This exists because of a specific failure on 2026-08-23: AWX exhausted PostgreSQL's 100
// connections and its UI began dropping requests, and NOTHING in this estate could see it. The
// only connection metric was awx_database_connections_total, which comes FROM AWX — so at the
// moment AWX could no longer get a connection, the metric that would have explained why went to
// "no data". A collector that reads the database directly keeps reporting when the application
// cannot, which is the whole point of measuring a dependency from outside its dependant.
//
// pg_settings_max_connections is deliberately kept: it turns headroom into a RATIO instead of a
// number compared against a ceiling hardcoded in a dashboard. When somebody raises the limit, the
// alert follows automatically rather than silently continuing to grade against the old value.
// ---------------------------------------------------------------------------------------------

prometheus.exporter.postgres "pg" {
  // No password: peer auth over the unix socket. See defaults/main.yml.
  data_source_names = ["postgresql:///postgres?host={{ alloy_postgres_socket_dir }}&user={{ alloy_postgres_role }}&sslmode=disable"]
}

discovery.relabel "pg" {
  targets = prometheus.exporter.postgres.pg.targets
  rule {
    target_label = "instance"
    replacement  = "{{ inventory_hostname }}"
  }
}

prometheus.scrape "postgres" {
  targets         = discovery.relabel.pg.output
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "postgres"
  forward_to      = [prometheus.relabel.postgres_keep.receiver]
}

// A keep-list for the same reason etcd has one: postgres_exporter's per-table collectors are a
// cardinality bomb on a database with AWX's schema, and the free tier is 10,000 active series.
// What survives is connection headroom, the counters needed to judge cache behaviour before
// touching shared_buffers, and enough of pg_stat_database to see errors and contention.
prometheus.relabel "postgres_keep" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex  = "up|pg_up|pg_settings_max_connections|pg_settings_superuser_reserved_connections|pg_settings_shared_buffers_bytes|pg_settings_work_mem_bytes|pg_settings_effective_cache_size_bytes|pg_stat_database_numbackends|pg_stat_database_(xact_commit|xact_rollback|blks_read|blks_hit|conflicts|deadlocks|temp_files|temp_bytes)|pg_stat_bgwriter_.+|pg_locks_count|pg_database_size_bytes|pg_exporter_last_scrape_error|pg_exporter_scrapes_total"
    action = "keep"
  }
}
{% endif %}
