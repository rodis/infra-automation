{#- Every metric pipeline forwards here: VictoriaMetrics on the watcher VPS (alloy_vm_enabled), and
    Grafana Cloud only if alloy_metrics_to_grafana — off since the cutover, 2026-10-08. One list, so a new
    pipeline cannot forget the second sink. -#}
{#- Every log pipeline forwards here, by the same reasoning: Grafana Cloud's Loki while
    alloy_logs_to_grafana, VictoriaLogs when alloy_logs_to_victorialogs. -#}
{%- set logs_sinks = ((['loki.write.grafana_cloud.receiver'] if alloy_logs_to_grafana | bool else []) + (['loki.write.victorialogs.receiver'] if alloy_logs_to_victorialogs | bool else [])) | join(', ') -%}
{%- set metrics_sinks = ((['prometheus.remote_write.grafana_cloud.receiver'] if alloy_metrics_to_grafana | bool else []) + (['prometheus.remote_write.victoriametrics.receiver'] if alloy_vm_enabled | bool else [])) | join(', ') -%}
// Managed by playbooks/observability/install_alloy.yml — edits here are overwritten.
//
// Host metrics only. PostgreSQL metrics are deliberately absent: they need a dedicated read-only
// pg_monitor role rather than the application's DB_USER, which is a database change of its own.

prometheus.exporter.unix "host" {
  // Trimmed on purpose. Grafana Cloud free allows 10,000 active series and the default collector
  // set runs 500-1000 per host, so the whole estate would sit near the cap before anything
  // interesting is added. These cover the questions actually being asked of this host: is it up,
  // is it stalling, is it out of disk or memory.
  set_collectors = [
    "cpu",
    "diskstats",
    "filesystem",
    "loadavg",
    "meminfo",
    "netdev",
    "stat",      // includes CPU steal — the counter that mattered when guests were locking up
    "time",      // clock drift, which Mimir cares about
    "uname",
    // Added 2026-10-10, once the series cap was gone (task collect-more-after-grafana):
    "pressure",  // PSI: how long tasks WAIT for cpu, memory and io — the stalls measured directly
    "vmstat",    // paging, swap-ins, OOM kills
    "netstat",   // TCP retransmits, listen overflows, resets
    "filefd",    // open file handles against the limit
    "systemd",   // unit state: a failed alloy or kubelet is visible from here
  ]

  // Services only, not every scope, slice and mount (~5 series per unit).
  systemd {
    unit_include = ".+\\.service"
  }

  // Pseudo-filesystems produce a series per mount and answer nothing.
  filesystem {
    fs_types_exclude = "^(autofs|binfmt_misc|cgroup.?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|procfs|pstore|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|sys|run/credentials/.+|var/lib/docker/.+|var/lib/containers/storage/.+)($|/)"
  }
}

// The unix exporter's targets carry __address__ = 127.0.0.1:12345, so without this every series
// would be labelled instance="127.0.0.1:12345" and be useless the moment there is a second host.
// Set here rather than on remote_write: a global rule also renames series scraped from something
// REMOTE, which stamped AWX's metrics with the name of the machine that scraped them.
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "instance"
    replacement  = "{{ inventory_hostname }}"
  }
}

prometheus.scrape "host" {
  targets    = discovery.relabel.host.output
  forward_to = [{{ metrics_sinks }}]

  scrape_interval = "{{ alloy_scrape_interval }}"

  // Without this every series is labelled instance="127.0.0.1:12345", which is useless the moment
  // there is more than one host. The inventory name is what the objectives and the ledgers use.
  job_name = "integrations/node_exporter"
}

// Alloy's OWN metrics (2026-10-10): what it sent, retried, failed and dropped, per sink. Until now the
// only place to read them was the host itself, so a collector quietly losing data was invisible from
// the checks (found 2026-10-09). A keep-list, because Alloy exports hundreds of internal series.
prometheus.scrape "alloy_self" {
  targets = [{
    __address__ = "127.0.0.1:12345",
    instance    = "{{ inventory_hostname }}",
  }]
  job_name        = "alloy"
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.relabel.alloy_self_keep.receiver]
}

prometheus.relabel "alloy_self_keep" {
  forward_to = [{{ metrics_sinks }}]
  rule {
    source_labels = ["__name__"]
    regex  = "up|alloy_build_info|alloy_component_controller_running_components|alloy_component_evaluation_queue_size|prometheus_remote_storage_(samples_total|samples_failed_total|samples_retried_total|samples_dropped_total|samples_pending|enqueue_retries_total|highest_timestamp_in_seconds|queue_highest_sent_timestamp_seconds)|loki_write_(sent_entries_total|dropped_entries_total|batch_retries_total|request_duration_seconds_count)|loki_source_file_files_active_total|loki_process_dropped_lines_total|process_resident_memory_bytes|process_cpu_seconds_total"
    action = "keep"
  }
}

{% if alloy_metrics_to_grafana | bool %}
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_remote_write_url }}"

    basic_auth {
      username = "{{ alloy_remote_write_user }}"
      password = "{{ alloy_remote_write_token }}"
    }

    // Mimir rejects out-of-order samples outright rather than dropping them quietly, so a backlog
    // after an outage can wedge the queue. Keep the buffer modest and let old samples go: for
    // "is this host alive", recent truth beats complete history.
    queue_config {
      capacity          = 2500
      max_shards        = 4
      max_samples_per_send = 500
    }

  }
}
{% endif %}

{% if alloy_vm_enabled | bool %}
// ---------------------------------------------------------------------------------------------
// SECOND SINK — VictoriaMetrics on the watcher VPS (trial, 2026-10-05; project self-hosted-metrics)
//
// Same series as Grafana Cloud, so the two can be compared before Grafana Cloud's metrics are dropped.
// vmauth routes this token to /api/v1/write only. TLS is pinned to the trial's self-signed certificate.
// VictoriaMetrics accepts out-of-order samples, unlike Mimir, so a backlog after an outage drains
// rather than wedging; the queue is still kept modest — the box's memory cap is shared.
// ---------------------------------------------------------------------------------------------

prometheus.remote_write "victoriametrics" {
  endpoint {
    url          = "{{ alloy_vm_url }}"
    bearer_token = "{{ alloy_vm_token }}"

    tls_config {
      ca_file     = "{{ alloy_vm_ca_file }}"
      min_version = "TLS13"
    }

    queue_config {
      capacity             = 2500
      max_shards           = 4
      max_samples_per_send = 500
    }
  }
}

{% endif %}
{% if alloy_ship_logs %}

// ---------------------------------------------------------------------------------------------
// LOGS
//
// Metrics say a host is unwell; logs say why. Every diagnosis on 2026-08-22 came from a log line
// and not from a threshold — soft lockups in dmesg, Alloy's own "permission denied", a Neutron
// port stuck DOWN — so this is the half that makes a retrospective possible.
//
// It also fixes a stated blind spot in AWX [67] Check kernel health: that reads dmesg live, the
// ring buffer wraps, and a reboot erases it entirely. Shipped to Loki, a soft lockup stays
// queryable for 14 days and survives the reboot that hid it.
// ---------------------------------------------------------------------------------------------

loki.relabel "journal" {
  // forward_to is empty on purpose: this component exists only to export .rules to the source
  // below. It is the documented way to attach relabelling to a journal source.
  forward_to = []

  // Keep the label set SMALL and bounded. Loki charges for stream cardinality, not volume, and
  // the free tier rejects writes rather than degrading. `unit` and `level` are bounded by the
  // machine; anything derived from message text or a PID is unbounded and would be a slow-motion
  // outage.
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  // Alloy is by far the noisiest unit on these hosts (~83k lines a day of it narrating its own scrape
  // loop), so its info and debug lines are dropped — in loki.process "journal" below, NOT here. This
  // used to be a relabel rule on journald's PRIORITY, and that silently dropped everything: Alloy writes
  // every line at priority 6 (info) and puts the real level only in the text, `level=warn|error`
  // (k8s-south-node-2, 2026-10-07: 1 error, 10 warn, 28 info, all priority 6). So its warnings and
  // errors — how we would learn that shipping broke — never reached Loki. Found while chasing a
  // dropped remote_write batch that only the host's own journal could explain.

  // Collapse transient per-login units into one stream. systemd names each SSH session
  // `session-<N>.scope` with an ever-increasing N, so left alone `unit` is an UNBOUNDED label and
  // every login creates a new Loki stream. Loki charges on stream cardinality and the free tier
  // rejects writes rather than degrading, so this is a slow-motion outage rather than a tidiness
  // issue. Already visible before this rule: session-5246, session-5248, and climbing.
  rule {
    source_labels = ["unit"]
    regex         = "session-\\d+\\.scope"
    target_label  = "unit"
    replacement   = "session.scope"
  }

  // Same shape: systemd-run and udev spawn transient units with generated names.
  rule {
    source_labels = ["unit"]
    regex         = "(run-r?[0-9a-f]+|systemd-[a-z]+-[0-9]+)\\.(scope|service|mount)"
    target_label  = "unit"
    replacement   = "transient"
  }
}

loki.source.journal "journal" {
  forward_to    = [loki.process.journal.receiver]
  relabel_rules = loki.relabel.journal.rules
  max_age       = "{{ alloy_journal_max_age }}"

  labels = {
    job      = "journal",
    instance = "{{ inventory_hostname }}",
  }
}

// Alloy's own lines: read the level from the TEXT (journald says "info" for all of them), label the
// line with it, and drop info/debug. Warnings and errors go through — the smoke alarm, with a battery.
// Every other unit passes untouched.
loki.process "journal" {
  forward_to = [{{ logs_sinks }}]

  stage.match {
    selector = "{unit=\"alloy.service\"}"

    stage.regex {
      expression = "level=(?P<alloy_level>[a-z]+)"
    }

    stage.labels {
      values = { level = "alloy_level" }
    }

    stage.drop {
      source              = "alloy_level"
      expression          = "^(info|debug)$"
      drop_counter_reason = "alloy_self_info_debug"
    }
  }
}

{% if alloy_logs_to_grafana | bool %}
loki.write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_loki_url }}"

    basic_auth {
      username = "{{ alloy_loki_user }}"
      password = "{{ alloy_loki_token }}"
    }
  }
}
{% endif %}
{% if alloy_logs_to_victorialogs | bool %}

// VictoriaLogs on the watcher VPS (2026-10-09). Loki's push format, through vmauth with the SAME
// token and pinned certificate as the metrics; Loki labels become VictoriaLogs stream fields.
loki.write "victorialogs" {
  endpoint {
    url          = "{{ alloy_vl_url }}"
    bearer_token = "{{ alloy_vm_token }}"

    tls_config {
      ca_file     = "{{ alloy_vm_ca_file }}"
      min_version = "TLS13"
    }
  }
}
{% endif %}
{% endif %}

{% if alloy_scrape_awx %}

// ---------------------------------------------------------------------------------------------
// AWX (level 3)
//
// AWX already publishes 70 Prometheus metrics of its own — capacity, remaining capacity, instance
// status, job launch counts, and awx_database_connections_total. Nothing needed installing for
// this; the endpoint was simply unread.
//
// Scraped from OUTSIDE the cluster AWX runs in, so that an AWX outage produces up{job="awx"} == 0
// rather than an absence of data. Absence is indistinguishable from a broken collector; a zero is
// a measurement.
// ---------------------------------------------------------------------------------------------

prometheus.scrape "awx" {
  targets = [{
    __address__      = "{{ alloy_awx_url | regex_replace('^https?://', '') | regex_replace('/$', '') }}",
    __scheme__       = "https",
    __metrics_path__ = "/api/v2/metrics",
  }]

  // No honor_labels, and no instance label on the target. AWX distinguishes its per-pod series with
  // `hostname` and `instance_uuid`, NOT with `instance` — checked, rather than inferred:
  //
  //   awx_instance_capacity{hostname="awx-task-…",instance_uuid="…",node_type="control"}
  //
  // honor_labels was added here on the assumption that a target `instance` label was colliding with
  // AWX's own and collapsing six series into one. That assumption came from num_dropped=18 matching
  // 6 pods x 3 capacity metrics, and it was wrong — there was never a collision, because the label
  // names differ. It is removed rather than left in as a harmless-looking extra: a setting kept for
  // a reason that turned out to be false is a trap for whoever reads it next.
  bearer_token    = "{{ alloy_awx_token }}"
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "awx"
  forward_to      = [{{ metrics_sinks }}]
}
{% endif %}

{% if alloy_has_etcd | default(false) %}

// ---------------------------------------------------------------------------------------------
// etcd (level 2) — only rendered on hosts where 127.0.0.1:2381 actually answered.
//
// etcd is the one Kubernetes component that exposes metrics without credentials, and it is also
// the one whose failure is hardest to diagnose after the fact: a slow or unhealthy etcd presents
// as the API server being slow, which presents as everything being slow.
// ---------------------------------------------------------------------------------------------

prometheus.scrape "etcd" {
  targets = [{
    __address__      = "127.0.0.1:2381",
    __scheme__       = "http",
    __metrics_path__ = "/metrics",
    instance         = "{{ inventory_hostname }}",
  }]
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "etcd"
  // Through the keep-list below, not straight to remote_write.
  forward_to      = [prometheus.relabel.etcd_keep.receiver]
}

// Alloy filters metrics with a prometheus.relabel COMPONENT in the forward chain. It has no
// `metric_relabel_config` block inside prometheus.scrape — that is Prometheus' own YAML config
// syntax, and putting it here made the config unparseable, so Alloy refused to start and master-1
// stopped shipping anything at all. The playbook's own assertion caught that; systemd reported the
// service as failed and the counters were zero.
//
// Why a keep-list at all: etcd cost 1478 active series from ONE node, of which
// grpc_server_handled_total alone was 731 through method x code x service cardinality. Three
// production control planes untrimmed would have been ~4400 and put the free tier's 10,000 out of
// reach. What survives is what the Kubernetes dashboard reads plus what the standard etcd alerts
// need. grpc_server_started_total is kept for request rate by method; handled_total is dropped,
// which costs the per-code error breakdown — the one real loss, and the dashboard says so.
prometheus.relabel "etcd_keep" {
  forward_to = [{{ metrics_sinks }}]

  rule {
    source_labels = ["__name__"]
    // Everything since 2026-10-10 (no series cap): ~1,500 series on one master. The old list is in git.
    regex  = ".+"
    action = "keep"
  }
}
{% endif %}
{% if alloy_has_apiserver | default(false) %}
// API server readiness — filled in 2026-09-28; this block used to be empty ("a follow-up").
//
// /readyz is readable anonymously (system:public-info-viewer), so this needs no token and no
// ServiceAccount. It matters most on production, where etcd is a single dedicated member that serves
// its metrics only over TLS with a client certificate — and that certificate is full read-write
// access to the cluster's data, which a metrics collector must not hold. /readyz includes the API
// server's own etcd check ("[+]etcd ok"), so probe_success here answers "can this control plane
// reach etcd", from every control-plane node, without that certificate.
prometheus.exporter.blackbox "apiserver" {
  config = "{ modules: { readyz: { prober: http, timeout: 5s, http: { valid_status_codes: [200], tls_config: { insecure_skip_verify: true } } } } }"

  target {
    name    = "readyz"
    address = "https://127.0.0.1:6443/readyz"
    module  = "readyz"
  }
}

discovery.relabel "apiserver" {
  targets = prometheus.exporter.blackbox.apiserver.targets
  rule {
    target_label = "instance"
    replacement  = "{{ inventory_hostname }}"
  }
}

prometheus.scrape "apiserver" {
  targets         = discovery.relabel.apiserver.output
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "apiserver"
  forward_to      = [prometheus.relabel.apiserver_keep.receiver]
}

prometheus.relabel "apiserver_keep" {
  forward_to = [{{ metrics_sinks }}]
  rule {
    source_labels = ["__name__"]
    regex  = "probe_success|probe_duration_seconds|probe_http_status_code"
    action = "keep"
  }
}
{% endif %}
{% if alloy_has_postgres | default(false) %}

// ---------------------------------------------------------------------------------------------
// PostgreSQL — only rendered on a host that actually has a local socket.
//
// This exists because of a specific failure on 2026-08-23: AWX exhausted PostgreSQL's 100
// connections and its UI began dropping requests, and NOTHING in this estate could see it. The
// only connection metric was awx_database_connections_total, which comes FROM AWX — so at the
// moment AWX could no longer get a connection, the metric that would have explained why went to
// "no data". A collector that reads the database directly keeps reporting when the application
// cannot, which is the whole point of measuring a dependency from outside its dependant.
//
// pg_settings_max_connections is deliberately kept: it turns headroom into a RATIO instead of a
// number compared against a ceiling hardcoded in a dashboard. When somebody raises the limit, the
// alert follows automatically rather than silently continuing to grade against the old value.
// ---------------------------------------------------------------------------------------------

prometheus.exporter.postgres "pg" {
  // No password: peer auth over the unix socket. See defaults/main.yml.
  data_source_names = ["postgresql:///postgres?host={{ alloy_postgres_socket_dir }}&user={{ alloy_postgres_role }}&sslmode=disable"]

  // enabled_collectors REPLACES the default set rather than adding to it, so this lists all eleven
  // upstream defaults (as reported by pg_scrape_collector_success on 2026-09-27) plus one.
  // Naming only the new collector would silently switch off connections, locks and database
  // stats, which dashboards and awx-healthy grade on.
  //
  // database_wraparound is the addition: transaction ID age per database, which awx-healthy gates
  // on (at the limit PostgreSQL refuses writes). It used to be read over SSH; unattended checks no
  // longer use SSH (infra-objectives CLAUDE.md, "Unattended checks never use SSH").
  enabled_collectors = [
    "database", "locks", "replication", "replication_slot", "roles", "stat_bgwriter",
    "stat_database", "stat_progress_vacuum", "stat_user_tables", "statio_user_tables", "wal",
    "database_wraparound",
  ]
}

discovery.relabel "pg" {
  targets = prometheus.exporter.postgres.pg.targets
  rule {
    target_label = "instance"
    replacement  = "{{ inventory_hostname }}"
  }
}

prometheus.scrape "postgres" {
  targets         = discovery.relabel.pg.output
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "postgres"
  forward_to      = [prometheus.relabel.postgres_keep.receiver]
}

// A keep-list for the same reason etcd has one: postgres_exporter's per-table collectors are a
// cardinality bomb on a database with AWX's schema, and the free tier is 10,000 active series.
// What survives is connection headroom, the counters needed to judge cache behaviour before
// touching shared_buffers, and enough of pg_stat_database to see errors and contention.
prometheus.relabel "postgres_keep" {
  forward_to = [{{ metrics_sinks }}]

  rule {
    source_labels = ["__name__"]
    // pg_stat_activity_* and the wraparound age were added 2026-09-27 so awx-healthy can read idle-in-
    // transaction, the oldest open transaction and XID age from here instead of over SSH: ~60
    // series (4 databases x 7 session states x 2, plus 4). The wraparound metric's `_seconds`
    // suffix is an upstream misnomer — its value is age(datfrozenxid), a transaction COUNT.
    regex  = "up|pg_up|pg_settings_max_connections|pg_settings_superuser_reserved_connections|pg_settings_shared_buffers_bytes|pg_settings_work_mem_bytes|pg_settings_effective_cache_size_bytes|pg_stat_database_numbackends|pg_stat_database_(xact_commit|xact_rollback|blks_read|blks_hit|conflicts|deadlocks|temp_files|temp_bytes)|pg_stat_bgwriter_.+|pg_locks_count|pg_database_size_bytes|pg_exporter_last_scrape_error|pg_exporter_scrapes_total|pg_stat_activity_count|pg_stat_activity_max_tx_duration|pg_database_wraparound_age_datfrozenxid_seconds"
    action = "keep"
  }
}
{% endif %}
{% if alloy_ship_logs and alloy_ship_postgres_logs and alloy_has_postgres | default(false) %}

// ---------------------------------------------------------------------------------------------
// PostgreSQL's own log. NOT in the journal -- see defaults/main.yml for why, and for the incident
// that made this necessary.
// ---------------------------------------------------------------------------------------------

local.file_match "postgresql" {
  // A glob, because the file is versioned (postgresql-15-main.log) and rotates weekly.
  path_targets = [{
    __path__ = "{{ alloy_postgres_log_glob }}",
    job      = "postgresql",
    instance = "{{ inventory_hostname }}",
  }]
}

loki.source.file "postgresql" {
  targets    = local.file_match.postgresql.targets
  forward_to = [loki.process.postgresql.receiver]
}

loki.process "postgresql" {
  // PostgreSQL emits multi-line records: a FATAL or ERROR line is routinely followed by an
  // unindented STATEMENT line carrying the query that caused it. Without this they arrive as
  // separate entries and the statement is orphaned from its error -- which is precisely the pair
  // you want when reading back an incident.
  stage.multiline {
    firstline = "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}"
    max_lines = 50
  }

  // Capture the line's OWN timestamp as well as its severity.
  stage.regex {
    expression = "^(?P<ts>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d+ \\S+) \\[\\d+\\] (?:\\S+ )?(?P<level>[A-Z]+):"
  }

  // Without this, Loki stamps every entry with the moment ALLOY READ IT, not when PostgreSQL wrote
  // it. Measured 2026-08-23: the first deploy backfilled the whole of that day's log and 1,513
  // FATAL lines -- including refusals from 10:28 and a restart at 17:39 -- all arrived stamped
  // 18:40:08. Counting them showed "1513 FATAL in the last hour" on a database that had been
  // healthy for hours.
  //
  // That is worse than losing the lines. An incident timeline that is confidently wrong invites
  // exactly the misreading this estate exists to prevent, and it survives into the ledgers.
  stage.timestamp {
    source = "ts"
    format = "2006-01-02 15:04:05.000 MST"
  }

  // Promote severity to a label so `| level="FATAL"` works the same way it does for journald.
  stage.labels {
    values = { level = "" }
  }

  forward_to = [{{ logs_sinks }}]
}
{% endif %}
{% if alloy_ship_logs and alloy_ship_pod_logs and alloy_has_pod_logs | default(false) %}

// ---------------------------------------------------------------------------------------------
// Container logs, scoped by namespace.
//
// Read from the node's filesystem rather than through the Kubernetes API, so this needs no
// kubeconfig, no ServiceAccount token on the host, and no inbound access to the cluster. The
// labels come from the path, which kubelet lays out as
// /var/log/pods/<namespace>_<pod>_<uid>/<container>/N.log
//
// Why this exists: on 2026-08-23 the whole diagnosis of an AWX outage came from `kubectl logs`,
// which had retained EIGHT MINUTES -- 144 errors saturating the entire window, and no history of
// when it started. Pod logs on disk rotate and vanish with the pod.
// ---------------------------------------------------------------------------------------------

local.file_match "pods" {
  path_targets = [
{% for ns in alloy_pod_log_namespaces %}
    {__path__ = "/var/log/pods/{{ ns }}_*/*/*.log"},
{% endfor %}
  ]
}

loki.source.file "pods" {
  targets = local.file_match.pods.targets

  // Start at the END of each file. Without this Alloy reads pod logs from the beginning, and on
  // 2026-08-23 that meant replaying container logs back to 2026-07-10 into a Loki that rejects
  // anything older than seven days -- HTTP 400 "timestamp too old", whole batches dropped, and the
  // role's own verification failing on both worker nodes.
  //
  // This is the same bound `alloy_journal_max_age` already puts on journald, and the lesson is that
  // it belongs on EVERY source that reads a file which predates the collector. A log file is
  // history; a collector starting fresh should not try to ship all of it.
  tail_from_end = true

  forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
  // containerd writes CRI format: "<rfc3339nano> <stdout|stderr> <F|P> <message>". Without this
  // every line arrives with that header glued to the front and the real message is unsearchable.
  stage.cri {}

  // etcd's slow-storage lines ("slow fdatasync", "apply request took too long", ...) are KEPT since
  // 2026-10-10. They were dropped while Grafana Cloud billed by volume: on the root disk they were 99%
  // of kube-system's lines. With etcd on its own volume (task south-etcd-volume) they should be rare,
  // and each one is now evidence about whether the move held.

  forward_to = [loki.relabel.pods.receiver]
}

loki.relabel "pods" {
  forward_to = [{{ logs_sinks }}]

  // A pod directory is <namespace>_<pod>_<uid>. Neither a namespace nor a pod name may contain an
  // underscore (RFC 1123), so splitting on "_" is exact rather than a guess.
  rule {
    source_labels = ["filename"]
    regex         = "/var/log/pods/([^_]+)_([^_]+)_[^/]+/([^/]+)/[^/]+"
    target_label  = "namespace"
    replacement   = "$1"
  }
  rule {
    source_labels = ["filename"]
    regex         = "/var/log/pods/([^_]+)_([^_]+)_[^/]+/([^/]+)/[^/]+"
    target_label  = "pod"
    replacement   = "$2"
  }
  rule {
    source_labels = ["filename"]
    regex         = "/var/log/pods/([^_]+)_([^_]+)_[^/]+/([^/]+)/[^/]+"
    target_label  = "container"
    replacement   = "$3"
  }
  // Drop `filename`: it carries the pod UID, which changes on every restart and would make each
  // restart a brand new stream. That is the unbounded-cardinality shape that `session-N.scope`
  // already caused once in the journald pipeline.
  rule {
    action = "labeldrop"
    regex  = "filename"
  }
  rule {
    target_label = "job"
    replacement  = "pods"
  }
  rule {
    target_label = "instance"
    replacement  = "{{ inventory_hostname }}"
  }
}
{% endif %}
{% if alloy_has_ksm | default(false) %}

// ---------------------------------------------------------------------------------------------
// kube-state-metrics — object state for the cluster.
//
// This closes the gap the Kubernetes dashboard has been carrying a warning about: etcd was the
// only component reachable without credentials, so pod phases, node conditions, deployment
// replicas and restart counts were all invisible. A cluster could have crash-looping pods and
// NotReady nodes with every panel green.
//
// Scraped over a NodePort on loopback, so nothing here holds a kubeconfig or a ServiceAccount
// token. The RBAC is consumed by kube-state-metrics inside the cluster; what crosses the boundary
// is an unauthenticated read-only metrics endpoint.
// ---------------------------------------------------------------------------------------------

prometheus.scrape "kube_state_metrics" {
  targets = [{
    __address__      = "127.0.0.1:{{ alloy_ksm_port }}",
    __scheme__       = "http",
    __metrics_path__ = "/metrics",
    // The CLUSTER, not this host. See alloy_cluster_name in defaults/main.yml.
    instance         = "{{ alloy_cluster_name }}",
  }]
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "kube-state-metrics"
  forward_to      = [prometheus.relabel.ksm_keep.receiver]
}

// A keep-list, as for etcd. kube-state-metrics is generous by default and its per-object label
// sets multiply quickly; what survives is what answers "is the cluster healthy" -- readiness,
// phases, restarts, desired-vs-available -- plus enough capacity to see a node filling up.
prometheus.relabel "ksm_keep" {
  forward_to = [{{ metrics_sinks }}]

  // kube_node_role .. kube_customresource_* added 2026-09-27 so platform-healthy can read from Grafana
  // instead of over SSH: control-plane count, chart/version pins, IngressClass and hosts, restart rates,
  // image tags, and the cert-manager / Doppler custom resources.
  rule {
    source_labels = ["__name__"]
    // Everything since 2026-10-10 (no series cap). kube-state-metrics only exposes the resources
    // roles/kube_state_metrics configures, so "everything" is still bounded. The old list is in git.
    regex  = ".+"
    action = "keep"
  }
}
{% endif %}
