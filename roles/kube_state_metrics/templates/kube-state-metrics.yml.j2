# Managed by rodis/infra-automation, roles/kube_state_metrics. Do not edit in the cluster.
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ksm_namespace }}
  labels:
    app.kubernetes.io/managed-by: infra-automation
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ ksm_service_account }}
  namespace: {{ ksm_namespace }}
automountServiceAccountToken: true
---
# READ ONLY, cluster-wide, and only the resources kube-state-metrics is configured to collect.
# No create, update, patch, delete or deletecollection anywhere. No secrets, no configmaps.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ ksm_service_account }}-read
rules:
  - apiGroups: [""]
    resources: [nodes, pods, namespaces, persistentvolumeclaims]
    verbs: [get, list, watch]
  - apiGroups: ["apps"]
    resources: [deployments, statefulsets, daemonsets, replicasets]
    verbs: [get, list, watch]
  - apiGroups: ["batch"]
    resources: [jobs]
    verbs: [get, list, watch]
  # Added 2026-09-27 for platform-healthy: still get/list/watch only, still no secrets or configmaps.
  - apiGroups: ["networking.k8s.io"]
    resources: [ingresses, ingressclasses]
    verbs: [get, list, watch]
  - apiGroups: ["cert-manager.io"]
    resources: [certificates, clusterissuers]
    verbs: [get, list, watch]
  - apiGroups: ["secrets.doppler.com"]
    resources: [dopplersecrets]
    verbs: [get, list, watch]
  # KSM's custom-resource support lists CRDs to discover the kinds it was told to watch.
  - apiGroups: ["apiextensions.k8s.io"]
    resources: [customresourcedefinitions]
    verbs: [get, list, watch]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: kube-state-metrics-crs
  namespace: {{ ksm_namespace }}
data:
  crs.yaml: |
{{ ksm_custom_resource_state | to_nice_yaml(indent=2) | indent(4, true) }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ ksm_service_account }}-read
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ ksm_service_account }}-read
subjects:
  - kind: ServiceAccount
    name: {{ ksm_service_account }}
    namespace: {{ ksm_namespace }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kube-state-metrics
  namespace: {{ ksm_namespace }}
  labels:
    app.kubernetes.io/name: kube-state-metrics
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: kube-state-metrics
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kube-state-metrics
      annotations:
        # A ConfigMap change does not restart a pod by itself; this makes it roll when the config does.
        infra-automation/crs-sha256: "{{ ksm_custom_resource_state | to_json | hash('sha256') }}"
    spec:
      serviceAccountName: {{ ksm_service_account }}
      # It only reads the API, so it needs nothing from the node and gets nothing.
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: kube-state-metrics
          image: {{ ksm_image }}
          args:
            - --resources={{ ksm_resources | join(',') }}
            - --port=8080
            - --telemetry-port=8081
            - --metric-labels-allowlist={{ ksm_metric_labels_allowlist }}
            - --custom-resource-state-config-file=/etc/ksm/crs.yaml
          volumeMounts:
            - name: crs
              mountPath: /etc/ksm
              readOnly: true
          ports:
            - containerPort: 8080
              name: http-metrics
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests: {cpu: 10m, memory: 64Mi}
            limits: {memory: 192Mi}
          livenessProbe:
            httpGet: {path: /healthz, port: 8080}
            initialDelaySeconds: 5
          readinessProbe:
            httpGet: {path: /, port: 8081}
            initialDelaySeconds: 5
      volumes:
        - name: crs
          configMap:
            name: kube-state-metrics-crs
---
apiVersion: v1
kind: Service
metadata:
  name: kube-state-metrics
  namespace: {{ ksm_namespace }}
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: kube-state-metrics
  ports:
    - name: http-metrics
      port: 8080
      targetPort: 8080
      nodePort: {{ ksm_node_port }}
