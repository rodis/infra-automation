{
  "interval": 60,
  "rules": [
    {
      "title": "Host not reporting",
      "folderUID": "infra",
      "ruleGroup": "management-plane",
      "orgID": 1,
      "condition": "C",
      "for": "5m",
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "labels": {
        "severity": "critical",
        "estate": "south"
      },
      "annotations": {
        "summary": "{{ $labels.instance }} has not reported for 5 minutes",
        "description": "Either the host is down, the collector has stopped, or writes are being rejected. These are indistinguishable from here \u2014 check the host directly before concluding anything, and remember AWX runs on this plane, so an objective trying to diagnose it may itself be affected.",
        "runbook": "ssh to the host; systemctl is-active alloy; then AWX [67] Check kernel health"
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "up",
            "instant": true,
            "range": false,
            "editorMode": "code",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "lt",
                  "params": [
                    1
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "type": "last",
                  "params": []
                }
              }
            ]
          }
        }
      ]
    },
    {
      "title": "Root filesystem filling",
      "folderUID": "infra",
      "ruleGroup": "management-plane",
      "orgID": 1,
      "condition": "C",
      "for": "15m",
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "labels": {
        "severity": "warning",
        "estate": "south"
      },
      "annotations": {
        "summary": "{{ $labels.instance }} has under 10% free on /",
        "description": "On the PostgreSQL VM this matters more than it looks: AWX stores everything in that database, and a full disk degrades AWX in ways that present as AWX being broken rather than as a disk problem."
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}",
            "instant": true,
            "range": false,
            "editorMode": "code",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "lt",
                  "params": [
                    0.1
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "type": "last",
                  "params": []
                }
              }
            ]
          }
        }
      ]
    },
    {
      "title": "Memory nearly exhausted",
      "folderUID": "infra",
      "ruleGroup": "management-plane",
      "orgID": 1,
      "condition": "C",
      "for": "15m",
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "labels": {
        "severity": "warning",
        "estate": "south"
      },
      "annotations": {
        "summary": "{{ $labels.instance }} has under 10% memory available",
        "description": "MemAvailable rather than free: free memory is meaningless on a host with a healthy page cache, and alerting on it produces noise that gets the channel muted."
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
            "instant": true,
            "range": false,
            "editorMode": "code",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "lt",
                  "params": [
                    0.1
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "type": "last",
                  "params": []
                }
              }
            ]
          }
        }
      ]
    },
    {
      "title": "Sustained CPU steal",
      "folderUID": "infra",
      "ruleGroup": "management-plane",
      "orgID": 1,
      "condition": "C",
      "for": "10m",
      "noDataState": "OK",
      "execErrState": "Alerting",
      "labels": {
        "severity": "warning",
        "estate": "south"
      },
      "annotations": {
        "summary": "{{ $labels.instance }} is losing over 5% of CPU to steal",
        "description": "The hypervisor is oversubscribed. NOTE: this is NOT the soft-lockup fault seen on west on 2026-08-22 \u2014 steal was near zero on hosts locking up hard, so a quiet version of this alert rules nothing out. Soft lockups are only visible on the host, via AWX [67] Check kernel health.",
        "runbook": "AWX [67] General: Machines: Check kernel health"
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "sum by (instance) (rate(node_cpu_seconds_total{mode=\"steal\"}[5m]))",
            "instant": true,
            "range": false,
            "editorMode": "code",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0.05
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "type": "last",
                  "params": []
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
